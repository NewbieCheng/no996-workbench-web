# 本地联调：先启动 Go 后端单实例监听 8080，再 npm run dev
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# remote = 调用后端 AI；demo = 文案工具本地样例、人设 mock
# VITE_WORKBENCH_AI_MODE=remote

# 可选：覆盖运行时 GET /api/v1/models/default-chat（见 API_CONTRACTS.md）
# VITE_CHAT_MODEL=deepseek-v4-flash

# 登录页本机演示账号预填（仅 localhost 生效）。
# 真实账号密码写在 .env.development.local（gitignore: *.local），仓库里保持为空。
# VITE_DEMO_PLATFORM_USER=
# VITE_DEMO_PLATFORM_PASSWORD=
# VITE_DEMO_ENTERPRISE_USER=
# VITE_DEMO_ENTERPRISE_PASSWORD=
# VITE_DEMO_PERSONAL_USER=
# VITE_DEMO_PERSONAL_PASSWORD=
